function goView(name, el) {
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const v = document.getElementById('view-'+name);
  if(v) v.classList.add('active');
  if(el) el.classList.add('active');
  else {
    document.querySelectorAll('.nav-item').forEach(n=>{
      if(n.textContent.toLowerCase().includes(name.replace(/s$/,''))) n.classList.add('active');
    });
  }
  renderChartsForView(name);
}

function launchApp() {
  document.getElementById('login-screen').style.opacity='0';
  document.getElementById('login-screen').style.transition='opacity .4s';
  setTimeout(()=>{
    document.getElementById('login-screen').style.display='none';
    const app = document.getElementById('app');
    app.classList.add('visible');
    setTimeout(()=>{ renderChartsForView('dashboard'); buildHeatmap(); buildFunnel(); },100);
  },400);
}

