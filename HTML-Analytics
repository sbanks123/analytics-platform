    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{...TICK,callback:v=>v+'%'},grid:gridOpts},y:{ticks:TICK,grid:{display:false}}}}
  });
}

function buildHeatmap() {
  const el = document.getElementById('heatmap-el');
  const days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  const hours=['6a','9a','12p','3p','6p','9p'];
  const data=[[1,2,3,3,5,4,2],[2,3,5,6,7,4,3],[2,3,4,5,8,7,4],[2,3,5,7,9,6,3],[1,2,3,5,7,8,5],[2,3,3,2,4,7,5]];
  let h='<div class="heatmap"><div class="hm-label"></div>';
  days.forEach(d=>h+=`<div class="hm-head">${d}</div>`);
  hours.forEach((hr,hi)=>{
    h+=`<div class="hm-label">${hr}</div>`;
    days.forEach((_,di)=>{
      const v=data[hi][di];
      const a=(0.08+v/9*0.88).toFixed(2);
      h+=`<div class="hm-cell" style="background:rgba(74,158,245,${a})" title="${days[di]} ${hr}: intensity ${v}/9"></div>`;
    });
  });
  h+='</div>';
  el.innerHTML=h;
}

function buildFunnel() {
  const el = document.getElementById('funnel-list');
  const funnel=[
    {l:'Impressions',v:'84.3K',pct:100,c:'#4A9EF5'},
    {l:'Profile Views',v:'18.2K',pct:72,c:'#9B7FE8'},
    {l:'Link Clicks',v:'2,190',pct:46,c:'#22C78A'},
    {l:'Leads',v:'312',pct:26,c:'#F5A623'},
    {l:'Conversions',v:'48',pct:12,c:'#E8212A'}
  ];
  el.innerHTML=funnel.map(f=>`
    <div class="funnel-row">
      <div class="funnel-label">${f.l}</div>
      <div class="funnel-bar" style="width:${f.pct}%;background:${f.c}14;border-color:${f.c};color:${f.c}">${f.l}</div>
      <div class="funnel-num">${f.v}</div>
    </div>`).join('');
}
